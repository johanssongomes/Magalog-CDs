datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  createdAt   DateTime @default(now())
}

model PerformanceMetric {
  id        String   @id @default(uuid())
  cellKey   String   @unique // ex: "ns_cliente_micro_01/out"
  value     String
  updatedAt DateTime @updatedAt
}

model PmtRecord {
  id                        Int      @id @default(autoincrement())
  ano                       Int
  mes                       Int
  cd                        String
  dia                       DateTime?
  modalAgrupado             String?
  sigla                     String?
  divMoveis                 String?
  canalVenda                String?
  tipoSaida                 String?
  modal                     String?
  valorPlanDiarioCd         Float?   @default(0)
  pedidoPlanDiarioCd        Float?   @default(0)
  cubPlanDiarioCd           Float?   @default(0)
  pecasPlanDiarioCd         Float?   @default(0)
  pedidoUnicoPlanDiarioCd   Float?   @default(0)
  modalSaida                String?
  categoria                 String?
  categoriaProdutividade    String?
  plataformaVenda           String?
  versao                    String?  @default("v1")
  arquivoOrigem             String?
  createdAt                 DateTime @default(now())

  @@index([ano, mes])
  @@index([cd])
  @@index([cd, ano, mes])
}

model PmtImport {
  id               Int      @id @default(autoincrement())
  ano              Int
  mes              Int
  versao           String   @default("v1")
  arquivoNome      String
  totalLinhas      Int      @default(0)
  cdFiltro         String?  @default("994")
  status           String   @default("concluido")
  substituiuBase   Boolean  @default(true)
  importedAt       DateTime @default(now())
}

model Colaborador {
  id               String   @id // Matrícula / ID
  contratado       String
  cargo            String
  centroDeCusto    String
  cd               String?  @default("994")
  login            String?
  cpf              String?
  rg               String?
  sexo             String?
  cargoAnterior    String?
  dataAdmissao     String?
  dataNascimento   String?
  situacaoSistema  String?  @default("Em Atividade Normal")
  status           String?
  possuiMedidas    String?
  possuiFeedback   String?
  idLider          String?
  nomeLider        String?
  setor            String?
  turno            String?
  ferias           String?
  codCentroCusto   String?
  gerencia         String?
  periodo45Dias    String?
  periodo90Dias    String?
  diaNiver         String?
  mesNiver         String?
  aniversario      String?
  novaIdade        String?
  tempoDeEmpresa   String?
  mesAdm           String?
  diaAdm           String?
  anoAdm           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

