datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  createdAt   DateTime @default(now())
}

model PerformanceMetric {
  id        String   @id @default(uuid())
  cellKey   String   @unique // ex: "ns_cliente_micro_01/out"
  value     String
  updatedAt DateTime @updatedAt
}
